# =============================================================
# NetSentinel — .gitignore
# =============================================================

# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
build/
.eggs/
.Python
pip-selfcheck.json

# ─── Virtual Environments ─────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Environment Variables (secrets) ─────────────────────────
.env
.env.local
.env.*.local

# ─── Pytest & Coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ─── Node / Frontend ──────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
*.timestamp-*.mjs
vite.config.*.timestamp*

# ─── Database ─────────────────────────────────────────────────
*.db
*.sqlite3

# ─── Runtime Directories (auto-created at startup) ────────────
# Runtime user uploads are ignored, but .gitkeep keeps the folder tracked
uploads/user_uploads/*
!uploads/user_uploads/.gitkeep

# ─── IDE / OS ─────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ─────────────────────────────────────────────────────
*.log

# ─── Model Binaries (tracked intentionally — remove lines below to exclude) ───
# models/**/*.joblib
# models/**/*.pkl
